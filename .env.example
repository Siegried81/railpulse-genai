# Copy to .env and fill in the provider(s) you use. Never commit .env.

# --- Active provider: "auto", "deepseek", "groq", "ollama", "openrouter" or "anthropic" ---
# "auto" tries DeepSeek first, then Groq (rotating through every GROQ_API_KEY*).
LLM_PROVIDER=auto

DB_PATH=data/railpulse_ai.db

# --- DeepSeek (hosted, paid, OpenAI-compatible) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- Groq (hosted free tier) ---
# Each key has its own per-minute quota; add GROQ_API_KEY_2, _3, ... without gaps.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_MODEL=openai/gpt-oss-120b

# --- Ollama (local, no key) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- OpenRouter (hosted free tier) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# --- Anthropic (prototyping only, not the open-source path) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
