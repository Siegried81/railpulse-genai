# Copy to .env and fill in the provider(s) you use. Never commit .env.

# --- Active provider: "auto", "deepseek", "groq", "ollama", "openrouter", "sambanova" or "anthropic" ---
# "auto" tries Groq first (rotating through every GROQ_API_KEY*), then SambaNova,
# DeepSeek, OpenRouter and a local Ollama. A provider without a key is skipped.
LLM_PROVIDER=auto

DB_PATH=data/railpulse_ai.db

# --- DeepSeek (hosted, paid, OpenAI-compatible) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- Groq (hosted free tier) ---
# Add GROQ_API_KEY_2, _3, ... without gaps. Groq applies its daily token cap per
# account, so a key only adds capacity when it comes from another account.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_MODEL=openai/gpt-oss-120b

# --- SambaNova Cloud (hosted free tier, OpenAI-compatible) ---
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=DeepSeek-V3.1

# --- Ollama (local, no key) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- OpenRouter (hosted free tier) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# --- Anthropic (prototyping only, not the open-source path) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
